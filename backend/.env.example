# PostgreSQL connection string (Supabase)
DATABASE_URL=postgres://user:pass@host:5432/dbname

# Supabase project URL — REQUIRED. Used to derive the JWKS endpoint and issuer
# for JWT verification. Set to your project ref URL; the server will not start
# without it. In production set to the Railway/Supabase project URL.
SUPABASE_URL=https://your-project-ref.supabase.co

# CORS allowed origins — comma-separated list of origins that may call the API.
# In production, set to your deployed frontend URL (e.g. Railway).
# If unset, defaults to http://localhost:5173 (local dev only).
CORS_ALLOWED_ORIGINS=https://your-frontend.up.railway.app

# Port the API server binds to (PaaS platforms inject this automatically)
PORT=8080
