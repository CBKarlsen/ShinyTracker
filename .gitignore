e2e/playwright-report/

# IDE / local tooling state
.idea/
.codegraph/

# Handoff archives (contents live in docs/handoff/)
*.zip

# Swift Package Manager build output
ios/**/.build/
ios/**/build/
# Per-user Xcode scheme state SwiftPM writes into every local package
ios/**/.swiftpm/

# Generated by xcodegen — ios/project.yml is the reviewable source of truth
ios/*.xcodeproj/
ios/App/Info.plist

# Real Supabase config — never commit keys (ios/App/Config/Secrets.example.xcconfig is checked in)
ios/App/Config/Secrets.xcconfig
