// Copy this file to Secrets.xcconfig (same directory, gitignored) and fill in real values,
// then run `xcodegen generate` in ios/.
//
// These land in Info.plist and are read by AuthConfig.fromBundle().
//
// NOTE: `//` starts a comment in xcconfig, so the two slashes must be split by `$()`, which
// expands to nothing. `https:/$()/x.supabase.co` becomes `https://x.supabase.co`.
// Writing `https:$()//…` does NOT work — the `//` is still adjacent and gets eaten.

SUPABASE_URL = https:/$()/your-project-ref.supabase.co

// The publishable / "anon" key. Public by design, but still not committed.
SUPABASE_ANON_KEY = your-publishable-anon-key

// The Go API's public base URL, read by APIConfig.fromBundle(). No trailing slash and no
// /api suffix — ShinyTrackerAPI appends the paths itself.
//
// Must be https:// on device: App Transport Security rejects cleartext HTTP, and the API is
// not deployed yet (see docs/handoff/IOS_API_CLIENT_SCOPE.md, P1). For a simulator run
// against a local server, http:/$()/localhost:8080 works because the simulator gets an ATS
// exemption for localhost.
API_BASE_URL = https:/$()/your-api-host.example.com
