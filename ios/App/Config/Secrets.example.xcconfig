// Copy this file to Secrets.xcconfig (same directory, gitignored) and fill in real values,
// then run `xcodegen generate` in ios/.
//
// These land in Info.plist and are read by AuthConfig.fromBundle().
//
// NOTE: `//` starts a comment in xcconfig, so the two slashes must be split by `$()`, which
// expands to nothing. `https:/$()/x.supabase.co` becomes `https://x.supabase.co`.
// Writing `https:$()//…` does NOT work — the `//` is still adjacent and gets eaten.

SUPABASE_URL = https:/$()/your-project-ref.supabase.co

// The publishable / "anon" key. Public by design, but still not committed.
SUPABASE_ANON_KEY = your-publishable-anon-key
