# Base URL of the ShinyTracker backend API (no trailing slash)
VITE_API_URL=http://localhost:8080

# Supabase Auth (managed). Project URL + publishable (anon) key.
# The publishable key is safe to expose in the frontend bundle.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx
